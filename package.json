{
  "name": "driftlet",
  "version": "1.2.7",
  "description": "Dependency-free 1D drift–diffusion–reaction (Poisson–Nernst–Planck) solver for semiconductors, electrochemistry and nerves, fast enough for live web demos",
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./kit": {
      "types": "./types/kit.d.ts",
      "default": "./src/kit.js"
    },
    "./plot": {
      "types": "./types/plot.d.ts",
      "default": "./src/plot.js"
    }
  },
  "main": "./src/index.js",
  "types": "./types/index.d.ts",
  "files": [
    "src",
    "docs",
    "types",
    "llms.txt"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "node --test",
    "bench": "node bench/bench.js",
    "hard": "node bench/hard.js",
    "stress": "node bench/stress.js",
    "smoke": "node tools/smoke.js",
    "shots": "node tools/shots.js",
    "lawsweep": "node tools/lawsweep.js",
    "fingerprint": "node tools/fingerprint.js",
    "prepublishOnly": "npm test && npm run types",
    "types": "rm -rf types && npx -y -p typescript@5 tsc --allowJs --declaration --emitDeclarationOnly --target es2022 --module nodenext --moduleResolution nodenext --outDir types src/index.js src/kit.js src/plot.js"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "drift-diffusion",
    "poisson-nernst-planck",
    "nernst-planck",
    "semiconductor",
    "pn-junction",
    "band-diagram",
    "solar-cell",
    "device-simulation",
    "electrochemistry",
    "battery",
    "impedance-spectroscopy",
    "cyclic-voltammetry",
    "ion-transport",
    "membrane-potential",
    "hodgkin-huxley",
    "physics",
    "simulation"
  ],
  "homepage": "https://markblundeberg.github.io/driftlet/demos/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markblundeberg/driftlet.git"
  },
  "bugs": {
    "url": "https://github.com/markblundeberg/driftlet/issues"
  },
  "author": "Mark Lundeberg",
  "license": "0BSD"
}
